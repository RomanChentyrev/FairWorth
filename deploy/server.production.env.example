NODE_ENV=production
PORT=3001
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/fairworth
DATABASE_SSL=true
DATABASE_POOL_SIZE=10
RUN_MIGRATIONS_ON_START=false
JWT_SECRET=generate_with_openssl_rand_hex_32
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_RATE_LIMIT=20
API_RATE_LIMIT=180
EMAIL_VERIFICATION_REQUIRED=true
FRONTEND_URL=https://app.example.com
LEGAL_OPERATOR_TYPE=individual
LEGAL_OPERATOR_NAME=REPLACE_WITH_OPERATOR_FULL_NAME
LEGAL_REGISTERED_ADDRESS=REPLACE_WITH_REGISTERED_ADDRESS
LEGAL_REGISTRATION_NUMBER=
LEGAL_JURISDICTION=REPLACE_WITH_JURISDICTION
LEGAL_CONTACT_EMAIL=legal@example.com
LEGAL_PRIVACY_EMAIL=privacy@example.com
LEGAL_SMTP_PROVIDER=Resend
LEGAL_DATA_HOSTING_COUNTRIES=REPLACE_WITH_COUNTRIES
LEGAL_TRANSFER_SAFEGUARD=REPLACE_WITH_LAWFUL_TRANSFER_MECHANISM
LEGAL_ACCOUNT_DELETION_DAYS=30
LEGAL_TECHNICAL_LOGS_DAYS=90
LEGAL_ACTIVITY_HISTORY_MONTHS=24
SESSION_RETENTION_DAYS=30
CACHE_RETENTION_DAYS=30
TECHNICAL_RETENTION_DAYS=90
BACKUP_RETENTION_DAYS=14
CORS_ORIGINS=https://app.example.com
TRUST_PROXY=true
SENTRY_DSN=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_TIMEOUT_MS=25000
TRAVELPAYOUTS_DATA_DIR=/tmp/tripalora-travelpayouts
SEARCHAPI_KEY=
SEARCHAPI_TIMEOUT_MS=30000
SEARCHAPI_MARKET=us
LITEAPI_KEY=
LITEAPI_BASE_URL=https://api.liteapi.travel/v3.0
HOTEL_CATALOG_PROVIDER=liteapi
HOTEL_RATE_PROVIDERS=liteapi,xotelo
CATALOG_BOOTSTRAP_LIMIT=100
CATALOG_SYNC_BATCH_HOTELS=500
CATALOG_SYNC_PAGE_SIZE=100
CATALOG_ON_DEMAND_SYNC_HOTELS=100
CATALOG_SYNC_LEASE_SECONDS=1800
CATALOG_WORKER_BATCHES=1
CATALOG_WORKER_ACTIVE_INTERVAL_MS=5000
CATALOG_WORKER_IDLE_INTERVAL_MS=60000
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_PHOTOS_ENABLED=true
GOOGLE_PLACES_TIMEOUT_MS=12000
GOOGLE_PLACES_MAX_PHOTOS=8
GOOGLE_PLACES_PHOTO_WIDTH_PX=1600
GOOGLE_PLACES_SEARCH_RADIUS_METERS=1500
GOOGLE_PLACES_MATCH_THRESHOLD=0.46
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000
EMAIL_FROM=Tripalora <no-reply@mail.example.com>
WORKER_INTERVAL_MS=60000
WORKER_PRICE_BATCH_SIZE=20
WORKER_EMAIL_BATCH_SIZE=25
ADMIN_EMAILS=admin@example.com
PARTNER_BOOKING_ENABLED=false
PARTNER_ALLOWED_HOSTS=
PARTNER_DEEP_LINK_TEMPLATE=
PARTNER_POSTBACK_SECRET=
