NODE_ENV=production
PORT=3001
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/fairworth
DATABASE_SSL=true
DATABASE_POOL_SIZE=10
RUN_MIGRATIONS_ON_START=false
JWT_SECRET=generate_with_openssl_rand_hex_32
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_RATE_LIMIT=20
FRONTEND_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
TRUST_PROXY=true
SENTRY_DSN=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
TRAVELPAYOUTS_TOKEN=
LITEAPI_KEY=
LITEAPI_BASE_URL=https://api.liteapi.travel/v3.0
HOTEL_CATALOG_PROVIDER=liteapi
HOTEL_RATE_PROVIDERS=liteapi,xotelo
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000
EMAIL_FROM=Fairworth <no-reply@mail.example.com>
ADMIN_EMAILS=admin@example.com
PARTNER_ALLOWED_HOSTS=
PARTNER_DEEP_LINK_TEMPLATE=
PARTNER_POSTBACK_SECRET=generate_a_different_secret
