# Use a separate database, email/API credentials and partner sandbox accounts.
NODE_ENV=production
PORT=3001
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/fairworth_staging
DATABASE_SSL=true
DATABASE_POOL_SIZE=5
RUN_MIGRATIONS_ON_START=false
JWT_SECRET=generate_a_staging_only_secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_RATE_LIMIT=50
EMAIL_VERIFICATION_REQUIRED=true
FRONTEND_URL=https://staging.example.com
LEGAL_OPERATOR_TYPE=company
LEGAL_OPERATOR_NAME=Fairworth Staging
LEGAL_REGISTERED_ADDRESS=NOT FOR PUBLICATION
LEGAL_REGISTRATION_NUMBER=STAGING
LEGAL_JURISDICTION=STAGING
LEGAL_CONTACT_EMAIL=legal-staging@example.com
LEGAL_PRIVACY_EMAIL=privacy-staging@example.com
LEGAL_SMTP_PROVIDER=Resend
LEGAL_DATA_HOSTING_COUNTRIES=STAGING
LEGAL_TRANSFER_SAFEGUARD=STAGING
LEGAL_ACCOUNT_DELETION_DAYS=30
LEGAL_TECHNICAL_LOGS_DAYS=90
LEGAL_ACTIVITY_HISTORY_MONTHS=24
SESSION_RETENTION_DAYS=30
CACHE_RETENTION_DAYS=30
TECHNICAL_RETENTION_DAYS=90
BACKUP_RETENTION_DAYS=14
CORS_ORIGINS=https://staging.example.com
TRUST_PROXY=true
SENTRY_DSN=
OPENROUTER_API_KEY=
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_TIMEOUT_MS=25000
LITEAPI_KEY=
LITEAPI_BASE_URL=https://api.liteapi.travel/v3.0
HOTEL_CATALOG_PROVIDER=liteapi
HOTEL_RATE_PROVIDERS=liteapi,xotelo
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_PHOTOS_ENABLED=true
GOOGLE_PLACES_TIMEOUT_MS=12000
GOOGLE_PLACES_MAX_PHOTOS=8
GOOGLE_PLACES_PHOTO_WIDTH_PX=1600
GOOGLE_PLACES_SEARCH_RADIUS_METERS=1500
GOOGLE_PLACES_MATCH_THRESHOLD=0.46
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000
EMAIL_FROM=Fairworth Staging <no-reply@staging.example.com>
WORKER_INTERVAL_MS=60000
WORKER_PRICE_BATCH_SIZE=10
WORKER_EMAIL_BATCH_SIZE=10
ADMIN_EMAILS=admin@example.com
PARTNER_BOOKING_ENABLED=false
PARTNER_ALLOWED_HOSTS=
PARTNER_DEEP_LINK_TEMPLATE=
PARTNER_POSTBACK_SECRET=
